*********************************************************************
* 
* Items
* 

* Item types
iyusea:
       equ  0                                  ; Useable objects
iyweap:
       equ  1                                  ; Weapons
iyarmr:
       equ  2                                  ; Armors, robes
iyshld:
       equ  3                                  ; Shields
iyhelm:
       equ  4                                  ; Helmets
iyglvs:
       equ  5                                  ; Gloves, gauntlets
iyboot:
       equ  6                                  ; Boots
iyring:
       equ  7                                  ; Rings, specials
iylght:
       equ  8                                  ; Light sources

* Capability data structure
cbname:
       equ  0                                  ; Name of capability. Pointer to null terminated string.
cbsize:
       equ  2                                  ; Structure size

* Material data structure
mtname:
       equ  0                                  ; Name of material. Pointer to null terminated string.
mtsize:
       equ  2                                  ; Structure size

* Item data structure
ittile:
       equ  0                                  ; Tile number
ittype:
       equ  1                                  ; Item type
itcpbl:
       equ  2                                  ; Capability
itmtrl:
       equ  3                                  ; Material
itdmac:
       equ  4                                  ; Damage if weapon, AC bonus if armor
itrari:
       equ  5                                  ; Rarity within tile: 1-10. A low rarity means that a tile is more likely to turn ito this item when picked.
itvalu:
       equ  6                                  ; Value in gold pieces
itsize:
       equ  8                                  ; Structure size

* Capabilities
cpbls:
       equ  $
cbnone:
       equ  0                                  ; None
       data txnone
cbstr:
       equ  1                                  ; Strength
       data txstre
cbint:
       equ  2                                  ; Intelligence
       data txinte
cbwis:
       equ  3                                  ; Wisdom
       data txwisd
cbdex:
       equ  4                                  ; Dexterity
       data txdext
cbcon:
       equ  5                                  ; Constitution
       data txcons
cbprot:
       equ  6                                  ; Protection
       data txprot
cbhlng:
       equ  7                                  ; Healing
       data txhlng
cbspd:
       equ  8                                  ; Speed
       data txspd
cbfire:
       equ  9                                  ; Fire
       data txfire
cbslp:
       equ  10                                 ; Sleeping
       data txslp
cbreca:
       equ  11                                 ; Recall
       data txreca
cbmine:
       equ  12                                 ; Mining
       data txmine

* Materials
mtrls:
       equ  $
madflt:
       equ  0                                  ; Default
       data txdflt
malthr:
       equ  1                                  ; Leather
       data txlthr
mairon:
       equ  2                                  ; Iron
       data txiron
mastel:
       equ  3                                  ; Steel
       data txstel
masilv:
       equ  4                                  ; Silver
       data txsilv
magold:
       equ  5                                  ; Gold
       data txgold
maobsi:
       equ  6                                  ; Obsidian
       data txobsi

* Items
items:
       equ  $

it_poti_heal:
       ;    potion of healing
       byte tpoti                              ; Tile
       byte iyusea                             ; Type
       byte cbhlng                             ; Capability
       byte madflt                             ; Material
       byte 0                                  ; Damage/AC
       byte 1                                  ; Rarity
       data 100                                ; Value

it_poti_spd:
       ;    potion of speed
       byte tpoti                              ; Tile
       byte iyusea                             ; Type
       byte cbspd                              ; Capability
       byte madflt                             ; Material
