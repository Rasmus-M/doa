* Metatile definitions
mtiles:
       equ  $
mtdark:
       byte >20,>20,>20,>20                    ; Darkness
mfloor:
       byte >80,>81,>88,>89                    ; Floor
mstone:
       byte >82,>83,>8a,>8b                    ; Stone wall
mwall:
       byte >84,>85,>8c,>8d                    ; Brick wall
mrubbl:
       byte >86,>87,>8e,>8f                    ; Rubble
mdoorc:
       byte >90,>91,>98,>99                    ; Closed door
mdooro:
       byte >92,>93,>9a,>9b                    ; Open door
mstair:
       byte >94,>95,>9c,>9d                    ; Staircase down
mstaiu:
       byte >96,>97,>9e,>9f                    ; Staircase up
more:
       byte >a0,>a1,>a8,>a9                    ; Ore
mcoins:
       byte >a2,>a3,>aa,>ab                    ; Gold coins
mchest:
       byte >a4,>a5,>ac,>ad                    ; Chest
mpoti:
       byte >a6,>a7,>ae,>af                    ; Potion
mscrl:
       byte >b0,>b1,>b8,>b9                    ; Scroll
mbook:
       byte >b2,>b3,>ba,>bb                    ; Book
