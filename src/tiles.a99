       byte >c4,>c5,>cc,>cd                    ; Dagger
mmace:
       byte >c6,>c7,>ce,>cf                    ; Mace
mring:
       byte >d0,>d1,>d8,>d9                    ; Ring
marmr:
       byte >d2,>d3,>da,>db                    ; Armor
mhelm:
       byte >d4,>d5,>dc,>dd                    ; Helm
mboot:
       byte >d6,>d7,>de,>df                    ; Boots
mglvs:
       byte >70,>71,>78,>79                    ; Gloves
mrobe:
       byte >72,>73,>7a,>7b                    ; Robes
mshld:
       byte >74,>75,>7c,>7d                    ; Shield
