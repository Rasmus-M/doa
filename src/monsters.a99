*********************************************************************
* 
* Monsters
* 

* Monster data structure

moname:
       equ  0                                  ; Name of monster. Pointer to null terminated string.
mopat:
       equ  2                                  ; Pattern number
molvl:
       equ  4                                  ; Level
mohp:
       equ  5                                  ; Hit points (max)
moac:
       equ  6                                  ; Armor class
modmg:
       equ  7                                  ; Damage
mosize:
       equ  8                                  ; Structure size

monstr:
       equ  $
**      Villain
* MOGRIC DATA TXVILL
* DATA 12                         ; Pattern number
* BYTE 10                         ; Level
* BYTE 270                        ; HP
* BYTE 22                         ; AC
* BYTE 50                         ; Damage
* Villain
movill:
       data txvill
       data 12                                 ; Pattern number
       byte 0                                  ; Level
       byte 2                                  ; HP
       byte 1                                  ; AC
       byte 1                                  ; Damage
