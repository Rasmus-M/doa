*********************************************************************
* 
* Subroutine template
* 
* r0:
* r1:
* 
* On return ...
* 
sub:
       mov  r11,*r10+                          ; Push return address onto the stack
* Return
       dect r10                                ; Pop return address off the stack
       mov  *r10,r11
       b    *r11
* // SUB
